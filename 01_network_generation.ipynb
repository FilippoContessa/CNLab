     "output_type": "display_data"
    }
   ],
   "source": [
    "# Density\n",
    "N=100\n",
    "A=erdos_renyi(N,1)\n",
    "M=np.sum(A)/2\n",
    "print('Number of edges:',M)\n",
    "density = M/(N*(N-1)/2)\n",
    "print(density)\n",
    "plot_adjacency_matrix(A, \"Erdos-Renyi Graph\")"
   ]
