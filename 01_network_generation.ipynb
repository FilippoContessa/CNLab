   "source": [
    "import networkx as nx\n",
    "G= nx.Graph() # Creo empty graph\n",
    "G.add_nodes_from(diseases, bipartite=0)\n",
    "G.add_nodes_from(genes, bipartite=1) # since we want to distinguish between disease a genes\n",
    "for _, row in edgelist.iterrows():\n",
