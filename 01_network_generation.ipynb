    "# Function to visualize an adjacency matrix\n",
    "def plot_adjacency_matrix(adj_matrix, title=\"Adjacency Matrix\"):\n",
    "    plt.figure(figsize=(6,6)) # questo non ho capito cosa sia\n",
    "    plt.imshow(adj_matrix, cmap='gray_r', interpolation='none') #quello per fare 0 bianchi, 1 scuri\n",
    "    plt.title(title)\n",
    "    plt.colorbar(label=\"Edge Weight\")\n",
    "    plt.show()\n",
    "\n",
    "# Check if A is symmetric (difference between A and A.T is zero) Ma tu pensa, A.T trovi la trasposta direttamente\n",
    "\n",
    "def is_symmetric(A):\n",
    "    return np.all(A - A.T == 0) #.all da true se tutti i valori sono true, false se almeno 1 è false\n",
    "\n",
    "def is_symmetric_v2(A):\n",
    "    return A == A.T #Questa è piu scomoda,fa la point by point e te lo fa vedere\n",
    "\n",
    "# same with np.isclose, se hai floating data è difficile dire se sono uguali uguali\n",
    "def is_symmetric(A):\n",
    "    return np.allclose(A, A.T)\n",
    "\n"
   ]
