    "# Ratio between standard deviation and mean number of edges goes to zero as N increases (termodynamic limit)\n",
    "n=100\n",
    "Ns=[10,25,50,75,100,500,1000]\n",
    "ratios=[]\n",
    "for N in Ns:\n",
    "    Ms=np.zeros(n)\n",
    "    for i in range(n):\n",
    "        A = erdos_renyi(N,0.1)\n",
    "        M=np.sum(A)/2\n",
