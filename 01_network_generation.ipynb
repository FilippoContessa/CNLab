   "source": [
    "diseases= edgelist['DiseaseID'].unique()\n",
    "Ndiseases= len(diseases)\n",
    "print(f\"Number of unique diseases: {Ndiseases}\")\n",
    "genes= edgelist['GeneID'].unique()\n",
    "Ngenes= len(genes)\n",
    "print(f\"Number of unique genes: {Ngenes}\")"
   ]
